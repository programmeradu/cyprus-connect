{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "cyprus-connect",
	"build": {
		"command": "node scripts/inject-scheduled-handler.mjs"
	},
	"compatibility_date": "2026-08-01",
	"keep_vars": true,
	"placement": {
		"mode": "smart"
	},
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"triggers": {
		"crons": [
			// Grant-alerts scan: every hour on the hour
			"0 * * * *",
			// Database keep-alive: daily at 06:15 UTC (stops the free-tier pause)
			"15 6 * * *",
			// Agent heartbeat: every 15 minutes (src/app/api/cron/agents)
			"*/15 * * * *"
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "cyprus-connect"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "f13143783bcc4d0fb0ef19b3140a462a",
			"localConnectionString": "postgresql://postgres.mvjasyxjkqnjhvhwkgjo:Sammyone%4012345sam@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"
		}
	]
}
