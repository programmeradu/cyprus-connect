# VerdeIQ - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration (Turso/LibSQL)
DATABASE_URL=file:./dev.db
DATABASE_AUTH_TOKEN=

# TURSO CONNECTION URL
TURSO_CONNECTION_URL=your_turso_connection_url
TURSO_AUTH_TOKEN=your_turso_auth_token

# Better-Auth with Google OAuth
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
# 1. Create a new project or select existing one
# 2. Go to "Credentials" → "Create Credentials" → "OAuth 2.0 Client ID"
# 3. Application type: Web application
# 4. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google (dev) and https://yourdomain.com/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Gemini AI API Key (Required for AI features)
# Get your key at: https://aistudio.google.com/apikey
# Used for: AI analytics, course generation, image/video generation
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini API
GOOGLE_GEMINI_API_KEY=your_gemini_api_key

# Climatiq API for real carbon emissions calculations
# Sign up at https://app.climatiq.io/api/signup for free (250 calls/month)
CLIMATIQ_API_KEY=your_climatiq_api_key

# OpenEI API for energy data
OPENEI_API_KEY=your_openei_api_key

# WikiRate API for corporate sustainability data
WIKIRATE_API_KEY=your_wikirate_api_key

# Better Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your_better_auth_secret

# Better Auth Configuration
# For production: https://verdeiqapp.vercel.app
# For local: http://localhost:3000
BETTER_AUTH_URL=https://verdeiqapp.vercel.app

# Google OAuth Credentials
# Configure redirect URIs in Google Cloud Console:
# - https://verdeiqapp.vercel.app/api/auth/callback/google
# - http://localhost:3000/api/auth/callback/google (for local development)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# QuickBooks OAuth Configuration
# Get credentials at: https://developer.intuit.com/app/developer/dashboard
# Start with sandbox environment for testing
QB_CLIENT_ID=your_quickbooks_client_id
QB_CLIENT_SECRET=your_quickbooks_client_secret
QB_REDIRECT_URI=https://verdeiqapp.vercel.app/api/oauth/quickbooks/callback
QB_ENVIRONMENT=sandbox
QB_SCOPE=com.intuit.quickbooks.accounting

# Xero OAuth Configuration
# Get credentials at: https://developer.xero.com/
# Use demo company for testing before going live
XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret
XERO_REDIRECT_URI=http://localhost:3000/api/oauth/xero/callback

# Security - Token Encryption (Required)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_base64_encoded_encryption_key_here

# Clerk Authentication (legacy - can be removed if not used)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Supabase Storage Configuration (Required for media generation)
# Get your project credentials from: https://supabase.com/dashboard
# Used for: Storing generated images and videos as HTTPS URLs
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ==============================================================================
# STRIPE PAYMENT CONFIGURATION (REQUIRED FOR MONETIZATION)
# ==============================================================================

# Stripe Secret Key (Server-side only)
# Get from: https://dashboard.stripe.com/apikeys
# IMPORTANT: Keep this secret! Never expose in client code
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# Stripe Publishable Key (Client-side safe)
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Stripe Webhook Secret (For webhook signature verification)
# Get from: https://dashboard.stripe.com/webhooks
# Create endpoint: https://yourdomain.com/api/stripe/webhook
# Select events: checkout.session.completed, customer.subscription.*
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (Create products in Stripe Dashboard)
# Go to: https://dashboard.stripe.com/products
# Create products: Pro ($49/mo), Enterprise ($199/mo), Credit packages
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_your_pro_plan_id
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_plan_id
NEXT_PUBLIC_STRIPE_CREDITS_100_PRICE_ID=price_your_100_credits_id
NEXT_PUBLIC_STRIPE_CREDITS_500_PRICE_ID=price_your_500_credits_id
NEXT_PUBLIC_STRIPE_CREDITS_1000_PRICE_ID=price_your_1000_credits_id

# App URL (Required for Stripe redirects)
NEXT_PUBLIC_APP_URL=https://verdeiqapp.vercel.app

# ==============================================================================
# Climate & Energy Data APIs
# ==============================================================================

# Electricity Maps API (Real-time carbon intensity data)
# Free tier: 30 requests/day, 100+ zones
# Get your key at: https://portal.electricitymaps.com/auth/login
ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_key

# OpenEI Utility Rates API (Energy pricing data)
# Free, unlimited for most use cases
# Get your key at: https://apps.openei.org/services/api/signup
OPENEI_API_KEY=your_openei_api_key

# News & Weather APIs

# News API Key (For sustainability news feed)
# Get your key at: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# Weather API Key (For climate data integration)
# Options: OpenWeatherMap, WeatherAPI.com
WEATHER_API_KEY=your_weather_api_key_here

# Email Notifications (SMTP Configuration)
# For Gmail: Enable 2FA first, then create app-specific password
# Get app password at: https://myaccount.google.com/apppasswords
# For production, consider SendGrid, Mailgun, or AWS SES
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@verdeiq.com

# Accounting Software Integrations (Optional)

# QuickBooks OAuth Configuration
# Get credentials at: https://developer.intuit.com/app/developer/dashboard
# Start with sandbox environment for testing
QB_CLIENT_ID=your_quickbooks_client_id
QB_CLIENT_SECRET=your_quickbooks_client_secret
QB_REDIRECT_URI=http://localhost:3000/api/oauth/quickbooks/callback
QB_ENVIRONMENT=sandbox
QB_SCOPE=com.intuit.quickbooks.accounting

# Xero OAuth Configuration
# Get credentials at: https://developer.xero.com/
# Use demo company for testing before going live
XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret
XERO_REDIRECT_URI=http://localhost:3000/api/oauth/xero/callback

# Security - Token Encryption (Required)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_base64_encoded_encryption_key_here

# Application Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ==============================================================================
# STRIPE SETUP GUIDE
# ==============================================================================

# Step 1: Create Stripe Account
# - Go to: https://dashboard.stripe.com/register
# - Complete verification process

# Step 2: Get API Keys
# - Go to: https://dashboard.stripe.com/apikeys
# - Copy "Publishable key" → NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# - Copy "Secret key" → STRIPE_SECRET_KEY
# - Use test keys (pk_test_* and sk_test_*) for development

# Step 3: Create Products & Prices
# - Go to: https://dashboard.stripe.com/products
# - Create "Pro" product: $49/month recurring
#   - Copy Price ID → NEXT_PUBLIC_STRIPE_PRO_PRICE_ID
# - Create "Enterprise" product: $199/month recurring
#   - Copy Price ID → NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID
# - Create "100 Credits": $9.99 one-time
#   - Copy Price ID → NEXT_PUBLIC_STRIPE_CREDITS_100_PRICE_ID
# - Create "500 Credits": $39.99 one-time
#   - Copy Price ID → NEXT_PUBLIC_STRIPE_CREDITS_500_PRICE_ID
# - Create "1000 Credits": $69.99 one-time
#   - Copy Price ID → NEXT_PUBLIC_STRIPE_CREDITS_1000_PRICE_ID

# Step 4: Configure Webhooks
# - Go to: https://dashboard.stripe.com/webhooks
# - Click "Add endpoint"
# - Endpoint URL: https://yourdomain.com/api/stripe/webhook
#   (For local testing: use Stripe CLI or ngrok)
# - Select events:
#   ✓ checkout.session.completed
#   ✓ customer.subscription.created
#   ✓ customer.subscription.updated
#   ✓ customer.subscription.deleted
#   ✓ invoice.payment_succeeded
#   ✓ invoice.payment_failed
#   ✓ payment_intent.succeeded
#   ✓ payment_intent.payment_failed
# - Copy "Signing secret" → STRIPE_WEBHOOK_SECRET

# Step 5: Local Webhook Testing (Optional)
# - Install Stripe CLI: https://stripe.com/docs/stripe-cli
# - Run: stripe listen --forward-to localhost:3000/api/stripe/webhook
# - Copy webhook signing secret to STRIPE_WEBHOOK_SECRET

# Step 6: Test Payment Flow
# - Use test cards: https://stripe.com/docs/testing
#   - Success: 4242 4242 4242 4242
#   - Decline: 4000 0000 0000 0002
# - Test subscription creation
# - Test credit purchases
# - Verify webhook events in Stripe Dashboard

# ==============================================================================
# DEPLOYMENT NOTES
# ==============================================================================

# For Production:
# - Use strong, randomly generated encryption keys
# - Switch to Stripe live mode (remove _test_ from keys)
# - Update webhook endpoint URL to production domain
# - Switch QuickBooks to production environment
# - Use professional email service (SendGrid/Mailgun)
# - Set NODE_ENV=production
# - Update NEXT_PUBLIC_APP_URL to production domain
# - Update Google OAuth redirect URIs in Google Cloud Console

# For Vercel Deployment:
# - Add all environment variables in Vercel dashboard
# - Ensure DATABASE_URL and DATABASE_AUTH_TOKEN are set for Turso
# - Update webhook URLs in Stripe dashboard with Vercel domain
# - Update Google OAuth authorized redirect URIs with Vercel domain

# ==============================================================================
# FREE API KEY RESOURCES
# ==============================================================================

# Gemini AI: https://aistudio.google.com/apikey (Free tier available)
# Google OAuth: https://console.cloud.google.com/ (Free)
# Stripe: https://stripe.com/ (Free, pay-per-transaction)
# Electricity Maps: https://portal.electricitymaps.com (Free: 30 req/day)
# OpenEI: https://apps.openei.org/services/api/signup (Free unlimited)
# News API: https://newsapi.org/register (Free: 100 req/day)

# VerdeIQ - Empowering SMEs to lead on sustainability 🌱
# Stripe EUR price IDs (Cyprus / EU)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_EUR=
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID_EUR=
NEXT_PUBLIC_STRIPE_CREDITS_100_PRICE_ID_EUR=
NEXT_PUBLIC_STRIPE_CREDITS_500_PRICE_ID_EUR=
NEXT_PUBLIC_STRIPE_CREDITS_1000_PRICE_ID_EUR=
